---
/** Search box that hands the query to /search (Pagefind). Works without JavaScript. */
interface Props {
  id?: string;
  label?: string;
  value?: string;
  class?: string;
}
const { id = 'site-search', label = 'Search articles', value, class: className } = Astro.props;
---

<form class:list={['search', className]} action="/search" method="get" role="search">
  <label class="visually-hidden" for={id}>{label}</label>
  <input id={id} name="q" type="search" placeholder={label} value={value} autocomplete="off" required />
  <button type="submit" aria-label="Search">
    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle>
      <path d="M20 20l-4-4" fill="none" stroke="currentColor" stroke-width="2"></path>
    </svg>
  </button>
</form>

<style>
  .search {
    display: flex;
    align-items: center;
    width: 380px;
    max-width: 100%;
    height: 56px;
    border: 1px solid var(--color-ink);
    background: var(--color-paper);
  }

  .search:focus-within {
    outline: 2px solid var(--color-mustard);
    outline-offset: 2px;
  }

  button {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    order: -1;
    width: 48px;
    height: 100%;
    padding: 0 0 0 6px;
    border: 0;
    background: none;
    color: var(--color-ink);
    cursor: pointer;
  }

  input {
    flex: 1;
    min-width: 0;
    height: 100%;
    padding: 0 18px 0 0;
    border: 0;
    background: none;
    color: var(--color-ink);
    font: inherit;
    font-size: 15px;
    line-height: 20px;
  }

  input::placeholder {
    color: var(--color-faint);
    opacity: 1;
  }

  input:focus {
    outline: none;
  }

  input::-webkit-search-cancel-button {
    cursor: pointer;
  }
</style>
