---
import { Image } from 'astro:assets';
import logo from '../../assets/brand/uwib-wide-light.webp';
import { company, footerColumns, legalLinks, siteOffices } from '../../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="inner">
    <div class="brand-col">
      <a href="/" class="brand" aria-label={`${company.name} home`}>
        <Image src={logo} alt="" width={182} data-color />
      </a>
      <p class="tagline">{company.tagline}</p>
      <ul class="offices">
        {
          siteOffices.map((o) => (
            <li>
              <span class="office-name">
                {o.label}
                <span class="state">, {o.stateCode}</span>
              </span>
              <a href={o.phoneHref}>{o.phone}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <nav class="columns" aria-label="Footer">
      {
        footerColumns.map((col) => (
          <details class="column" open>
            <summary>{col.title}</summary>
            <ul>
              {col.links.map((l) => (
                <li>
                  <a href={l.href} {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}>
                    {l.label}
                    {l.external && <span aria-hidden="true"> ↗</span>}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ))
      }
    </nav>
  </div>

  <div class="legal">
    <p>© {year} {company.name}</p>
    <ul>
      {
        legalLinks.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<script>
  // Footer columns are collapsible on small screens only.
  const mq = window.matchMedia('(max-width: 760px)');
  const sync = () => {
    for (const d of document.querySelectorAll<HTMLDetailsElement>('.site-footer details')) d.open = !mq.matches;
  };
  sync();
  mq.addEventListener('change', sync);
</script>

<style>
  .site-footer {
    background: var(--color-night);
    color: #d6d6d6;
    padding: 72px var(--gutter) 36px;
  }

  .inner,
  .legal {
    max-width: var(--container);
    margin-inline: auto;
  }

  .inner {
    display: flex;
    justify-content: space-between;
    gap: 48px;
    padding-bottom: 56px;
  }

  .brand-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 420px;
  }

  .brand img {
    width: 182px;
    height: auto;
  }

  .tagline {
    max-width: 340px;
    color: var(--color-ink-muted);
    font-size: 14px;
    line-height: 22px;
  }

  .offices {
    display: flex;
    gap: 36px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }

  .offices li {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .office-name {
    color: var(--color-mustard);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.13em;
    line-height: 14px;
    text-transform: uppercase;
  }

  .state {
    display: none;
  }

  .offices a {
    color: #d6d6d6;
    font-size: 13px;
    line-height: 21px;
    text-decoration: none;
  }

  .columns {
    display: flex;
    gap: 72px;
  }

  summary {
    margin-bottom: 14px;
    color: #7a7a7a;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.13em;
    line-height: 14px;
    text-transform: uppercase;
    list-style: none;
    pointer-events: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .column ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .column a {
    color: #e6e6e6;
    font-size: 14px;
    line-height: 30px;
    text-decoration: none;
  }

  .column a:hover,
  .offices a:hover,
  .legal a:hover {
    color: var(--color-mustard);
  }

  .legal {
    display: flex;
    justify-content: space-between;
    gap: 8px 24px;
    padding-top: 20px;
    border-top: 1px solid #262626;
    color: #6a6a6a;
    font-size: 11px;
    letter-spacing: 0.04em;
    line-height: 14px;
  }

  .legal ul {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .legal li + li::before {
    content: '·';
    padding-inline: 6px;
  }

  .legal a {
    color: inherit;
    text-decoration: none;
  }

  @media (max-width: 1100px) {
    .inner {
      flex-direction: column;
    }
  }

  @media (max-width: 760px) {
    .site-footer {
      padding: 56px 20px 32px;
    }

    .inner {
      gap: 32px;
      padding-bottom: 32px;
    }

    .offices {
      flex-direction: column;
      gap: 0;
      margin-top: 16px;
      border-top: 1px solid #262626;
    }

    .offices li {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      padding-block: 14px;
      border-bottom: 1px solid #262626;
    }

    .state {
      display: inline;
    }

    .offices a {
      color: #e6e6e6;
      font-size: 14px;
    }

    .columns {
      flex-direction: column;
      gap: 0;
    }

    .column {
      border-bottom: 1px solid #262626;
    }

    summary {
      display: flex;
      justify-content: space-between;
      margin: 0;
      padding-block: 16px;
      color: #bdbdbd;
      font-size: 12px;
      line-height: 16px;
      pointer-events: auto;
      cursor: pointer;
    }

    summary::after {
      content: '+';
      font-size: 16px;
      font-weight: 400;
      letter-spacing: 0;
    }

    details[open] summary::after {
      content: '–';
    }

    .column ul {
      padding-bottom: 12px;
    }

    .legal {
      flex-direction: column-reverse;
      border-top: 0;
      padding-top: 0;
      color: #7a7a7a;
      line-height: 16px;
    }
  }
</style>
