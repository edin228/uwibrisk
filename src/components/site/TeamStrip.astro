---
/**
 * "Faces, not phone trees." Header row plus a horizontally scrolling strip of
 * color team portraits that bleeds off the right edge.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import TextLink from '../ui/TextLink.astro';

interface Props {
  members: CollectionEntry<'team'>[];
  eyebrow?: string;
  heading: string;
  text?: string;
  link?: { label: string; href: string };
  /** Background: white (default) or the warm gray surface. */
  surface?: 'paper' | 'surface';
}
const { members, eyebrow, heading, text, link, surface = 'paper' } = Astro.props;
---

<section class:list={['team-strip', `surface-${surface}`]} aria-labelledby="team-strip-heading">
  <div class="head">
    <div class="title">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2 id="team-strip-heading">{heading}</h2>
    </div>
    <div class="aside">
      {text && <p>{text}</p>}
      <div class="aside-foot">
        {link && <TextLink href={link.href}>{link.label}</TextLink>}
        <div class="controls">
          <button type="button" class="arrow" data-dir="-1" aria-label="Previous team members" disabled>
            <span aria-hidden="true">←</span>
          </button>
          <button type="button" class="arrow" data-dir="1" aria-label="More team members">
            <span aria-hidden="true">→</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <ul class="strip">
    {
      members.map((m) => (
        <li>
          <a href={`/team/${m.id}`} draggable="false">
            <Image
              src={m.data.photo}
              alt={m.data.photoAlt}
              width={560}
              widths={[280, 560]}
              sizes="280px"
              draggable="false"
              data-color
            />
            <span class="name">{m.data.name}</span>
            <span class="role">{m.data.role}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<script>
  // The strip has no visible scrollbar, so give it arrow buttons and, for mouse
  // users, click-and-drag. Touch devices already swipe natively.
  for (const section of document.querySelectorAll<HTMLElement>('.team-strip')) {
    const strip = section.querySelector<HTMLElement>('.strip')!;
    const [prev, next] = section.querySelectorAll<HTMLButtonElement>('.arrow');
    const smooth = window.matchMedia('(prefers-reduced-motion: no-preference)');

    const sync = () => {
      const max = strip.scrollWidth - strip.clientWidth;
      prev.disabled = strip.scrollLeft <= 1;
      next.disabled = strip.scrollLeft >= max - 1;
    };
    strip.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);
    sync();

    for (const btn of [prev, next]) {
      btn.addEventListener('click', () => {
        const step = Math.max(strip.clientWidth * 0.8, 300) * Number(btn.dataset.dir);
        strip.scrollBy({ left: step, behavior: smooth.matches ? 'smooth' : 'auto' });
      });
    }

    let pointer: number | null = null;
    let startX = 0;
    let startScroll = 0;
    let dragged = false;

    strip.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      pointer = e.pointerId;
      startX = e.clientX;
      startScroll = strip.scrollLeft;
      dragged = false;
    });

    strip.addEventListener('pointermove', (e) => {
      if (e.pointerId !== pointer) return;
      const dx = e.clientX - startX;
      if (!dragged) {
        if (Math.abs(dx) < 5) return;
        // Capture only once it's a real drag, so a plain click still reaches the link.
        dragged = true;
        strip.setPointerCapture(e.pointerId);
        strip.classList.add('is-dragging');
      }
      strip.scrollLeft = startScroll - dx;
    });

    const end = (e: PointerEvent) => {
      if (e.pointerId !== pointer) return;
      pointer = null;
      if (strip.hasPointerCapture(e.pointerId)) strip.releasePointerCapture(e.pointerId);
      // Dropping the class turns scroll snapping back on, which settles on a card.
      strip.classList.remove('is-dragging');
    };
    strip.addEventListener('pointerup', end);
    strip.addEventListener('pointercancel', end);

    // A drag that ends over a portrait shouldn't open that person's page.
    strip.addEventListener(
      'click',
      (e) => {
        if (!dragged) return;
        e.preventDefault();
        e.stopPropagation();
        dragged = false;
      },
      true,
    );
  }
</script>

<style>
  .team-strip {
    display: flex;
    flex-direction: column;
    gap: 56px;
    padding-block: clamp(80px, 9.7vw, 140px) clamp(80px, 10.4vw, 150px);
    overflow: hidden;
  }

  .surface-surface {
    background: var(--color-surface);
  }

  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px 64px;
    width: 100%;
    max-width: calc(var(--container) + 2 * var(--gutter));
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .title {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 640px;
  }

  h2 {
    letter-spacing: -0.04em;
  }

  .aside {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    flex-shrink: 0;
    width: 340px;
    font-size: 15px;
    line-height: 25px;
  }

  .aside-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    align-self: stretch;
  }

  .controls {
    display: flex;
    gap: 8px;
    margin-left: auto;
  }

  .arrow {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--color-ink);
    background: none;
    color: var(--color-ink);
    font-size: 18px;
    cursor: pointer;
    transition:
      background-color 0.15s,
      color 0.15s,
      opacity 0.15s;
  }

  .arrow:hover:not(:disabled) {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .arrow:disabled {
    opacity: 0.25;
    cursor: default;
  }

  .strip {
    display: flex;
    gap: 20px;
    margin: 0;
    padding: 0 var(--gutter) 8px max(var(--gutter), calc((100vw - var(--container)) / 2));
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
    list-style: none;
  }

  .strip::-webkit-scrollbar {
    display: none;
  }

  @media (pointer: fine) {
    .strip {
      cursor: grab;
    }
  }

  .strip.is-dragging {
    scroll-snap-type: none;
    cursor: grabbing;
    user-select: none;
  }

  .strip.is-dragging a {
    pointer-events: none;
  }

  .strip li {
    flex: 0 0 280px;
    scroll-snap-align: start;
  }

  .strip a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: inherit;
    text-decoration: none;
  }

  .strip img {
    width: 280px;
    height: 360px;
    margin-bottom: 12px;
    object-fit: cover;
    object-position: 50% 30%;
  }

  .name {
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 22px;
    line-height: 28px;
  }

  .strip a:hover .name {
    text-decoration: underline;
    text-decoration-color: var(--color-mustard);
    text-underline-offset: 4px;
  }

  .role {
    color: var(--color-muted);
    font-size: 12px;
    line-height: 16px;
  }

  @media (max-width: 760px) {
    .team-strip {
      gap: 32px;
    }

    .head {
      flex-direction: column;
      align-items: flex-start;
    }

    .aside {
      width: auto;
    }

    .strip li {
      flex-basis: 160px;
    }

    .strip img {
      width: 160px;
      height: 200px;
    }

    .name {
      font-size: 17px;
      line-height: 22px;
    }
  }
</style>
