---
/**
 * The redesign's signature layout: a 300px label column (eyebrow + short mustard
 * bar, optional heading/intro) beside a 948px content column. Collapses to one
 * column on small screens.
 */
interface Props {
  eyebrow: string;
  /** Optional heading/intro shown under the eyebrow in the label column. */
  heading?: string;
  intro?: string;
  surface?: 'paper' | 'surface' | 'night';
  /** Vertical padding: default section rhythm or compact. */
  space?: 'default' | 'compact' | 'none';
  id?: string;
  class?: string;
}
const { eyebrow, heading, intro, surface = 'paper', space = 'default', id, class: className } = Astro.props;
---

<section id={id} class:list={['label-section', `surface-${surface}`, `space-${space}`, className, { 'on-dark': surface === 'night' }]}>
  <div class="inner">
    <div class="label-col">
      <p class="eyebrow">{eyebrow}</p>
      <span class="bar" aria-hidden="true"></span>
      {heading && <h2 class="label-heading">{heading}</h2>}
      {intro && <p class="label-intro">{intro}</p>}
      <slot name="label" />
    </div>
    <div class="content-col">
      <slot />
    </div>
  </div>
</section>

<style>
  .surface-surface {
    background: var(--color-surface);
  }

  .surface-night {
    background: var(--color-night);
    color: var(--color-ink-body);
  }

  .space-default {
    padding-block: clamp(80px, 9.7vw, 140px) clamp(72px, 8.3vw, 120px);
  }

  .space-compact {
    padding-block: clamp(56px, 6vw, 88px);
  }

  .inner {
    display: flex;
    gap: 64px;
    max-width: calc(var(--container) + 2 * var(--gutter));
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .label-col {
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex-shrink: 0;
    width: var(--label-col);
    padding-top: 12px;
  }

  .bar {
    width: 36px;
    height: 2px;
    background: var(--color-mustard);
  }

  .label-heading {
    margin-top: 10px;
    font-size: clamp(28px, 1rem + 1.2vw, 34px);
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  .surface-night .label-heading {
    color: var(--color-paper);
  }

  .label-intro {
    color: var(--color-body);
    font-size: 15px;
    line-height: 25px;
  }

  .surface-night .label-intro {
    color: var(--color-ink-body);
  }

  .content-col {
    flex: 1;
    min-width: 0;
    max-width: 948px;
  }

  @media (max-width: 1100px) {
    .inner {
      flex-direction: column;
      gap: 28px;
    }

    .label-col {
      width: auto;
      padding-top: 0;
    }
  }
</style>
