---
/**
 * Photo hero for inner pages (coverage, industry, about). Use with
 * <SiteLayout header="overlay">. Actions go in the `actions` slot (stacked
 * buttons on the right on desktop).
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  title: string;
  lead?: string | undefined;
  image: ImageMetadata;
  /** Decorative by default (the heading carries the meaning). */
  imageAlt?: string;
  imagePosition?: string;
  crumbs?: { label: string; href?: string }[];
  /** Minimum height on desktop. */
  height?: number;
}
const { title, lead, image, imageAlt = '', imagePosition = '50% 55%', crumbs, height = 620 } = Astro.props;
---

<section class="page-hero" style={`--hero-h: ${height}px; --hero-pos: ${imagePosition}`}>
  <Image class="bg" src={image} alt={imageAlt} widths={[780, 1440, 2000]} sizes="100vw" loading="eager" fetchpriority="high" />
  <div class="shade" aria-hidden="true"></div>
  <div class="content">
    <div class="text">
      {crumbs && <Breadcrumbs items={crumbs} />}
      <h1>{title}</h1>
      {lead && <p class="lead">{lead}</p>}
      <slot name="after-lead" />
    </div>
    {
      Astro.slots.has('actions') && (
        <div class="actions">
          <slot name="actions" />
        </div>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: var(--hero-h);
    padding: calc(var(--header-h) + 80px) var(--gutter) 64px;
    background: var(--color-night);
    color: var(--color-paper);
    overflow: hidden;
  }

  .bg,
  .shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .bg {
    object-fit: cover;
    object-position: var(--hero-pos);
  }

  .shade {
    background: linear-gradient(
      180deg,
      rgb(20 20 20 / 0.65) 0%,
      rgb(20 20 20 / 0.15) 25%,
      rgb(20 20 20 / 0.55) 60%,
      rgb(20 20 20 / 0.95) 100%
    );
  }

  .content {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px 64px;
    width: 100%;
    max-width: var(--container);
    margin-inline: auto;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 22px;
    max-width: 860px;
  }

  h1 {
    color: var(--color-paper);
    font-size: clamp(48px, 1.5rem + 5vw, 96px);
    letter-spacing: -0.05em;
    line-height: 0.98;
  }

  .lead {
    max-width: 600px;
    color: #d6d6d6;
    font-size: 18px;
    line-height: 28px;
  }

  .actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex-shrink: 0;
    width: 300px;
    padding-bottom: 6px;
  }

  .actions :global(.btn) {
    width: 100%;
    padding-block: 17px;
  }

  @media (max-width: 960px) {
    .page-hero {
      min-height: 0;
      padding: calc(var(--header-h) + 140px) 20px 36px;
    }

    .content {
      flex-direction: column;
      align-items: stretch;
    }

    .text {
      gap: 16px;
    }

    .lead {
      font-size: 16px;
      line-height: 25px;
    }

    .actions {
      width: 100%;
      gap: 10px;
    }
  }
</style>
