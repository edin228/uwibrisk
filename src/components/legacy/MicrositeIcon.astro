---
/** Line icons from the old hotels / Coffee & Contracts landing pages (decorative). */
interface Props {
  type: string;
}
const { type } = Astro.props;
---

{
  type === 'people' ? (
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3" /><circle cx="17" cy="9" r="2.3" /><path d="M3.5 19c.5-4 2.3-6 5.5-6s5 2 5.5 6M14 14c3-.6 5.3 1 6 4" /></svg>
  ) : type === 'operations' ? (
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="3.5" width="14" height="17" rx="1" /><path d="M9 8h6M9 12h6M9 16h4" /></svg>
  ) : type === 'security' ? (
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="1" /><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v2.5" /></svg>
  ) : type === 'roaster' ? (
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3c.8 3.6 5 5.4 5 10.2a5 5 0 0 1-10 0c0-2.3 1.1-3.8 2.4-4.8.3 1.6 1 2.5 2 2.9C10.9 8.8 11 6 12 3z" /></svg>
  ) : type === 'cafe' ? (
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 9.5h11v4.5a5 5 0 0 1-5 5h-1a5 5 0 0 1-5-5zM15.5 10.5h1.5a2.5 2.5 0 0 1 0 5h-1.5M8.5 3.5c-.7.9-.7 2 0 3M12 3.5c-.7.9-.7 2 0 3" /></svg>
  ) : type === 'importer' ? (
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7.5 12 3.5l9 4v9l-9 4-9-4zM3 7.5l9 4 9-4M12 11.5v9" /></svg>
  ) : (
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5M5.5 10.5V20h13v-9.5M9 20v-5h6v5" /></svg>
  )
}
