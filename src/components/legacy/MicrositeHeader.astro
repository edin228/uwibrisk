---
/**
 * Header of the old landing-page microsites (hotels, Coffee & Contracts): logo lockup,
 * desktop nav and a <details> mobile menu. Styles: src/styles/microsites/hotels.css.
 * Use in BaseLayout's header slot: <MicrositeHeader slot="header" brand={brand} />.
 */
import { Image } from 'astro:assets';
import logo from '../../assets/brand/uwib-wide-white.png';
import type { MicrositeBrand } from '../../data/legacy/hotels';
import { altFor } from '../../lib/alt';
import Lines from './Lines.astro';

interface Props {
  brand: MicrositeBrand;
}
const { brand } = Astro.props;
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (item: MicrositeBrand['nav'][number]) =>
  item.activePrefix ? path.startsWith(item.activePrefix) : path === item.href;
const navLabel = brand.navLabel.toLowerCase();
---

<header class="hm-site hm-chrome hm-header">
  <div class="hm-headerInner">
    <a href={brand.home} class="hm-brandLockup" aria-label={`${brand.label} home`}>
      <span class="hm-logo">
        <Image
          src={logo}
          alt={altFor('src/assets/brand/uwib-wide-white.png')}
          widths={[182, 364]}
          sizes="182px"
          class="hm-fill-contain"
          loading="eager"
          data-color
        />
      </span>
      <span class="hm-brandDivider"></span>
      <span class="hm-brandDescriptor"><Lines text={brand.descriptor} /></span>
    </a>

    <nav class="hm-desktopNav" aria-label={brand.navLabel}>
      {brand.nav.map((item) => <a href={item.href} class={isActive(item) ? 'hm-navActive' : undefined}>{item.label}</a>)}
      <a href={brand.cta.href} class="hm-headerCta">{brand.cta.label}</a>
    </nav>

    <details class="hm-mobileMenu" data-microsite-menu>
      <summary aria-label={`Open ${navLabel} navigation`}><span></span><span></span></summary>
      <nav aria-label={`Mobile ${navLabel}`}>
        {brand.nav.map((item) => <a href={item.href}>{item.label}</a>)}
        <a href={brand.cta.href}>{brand.cta.label}</a>
      </nav>
    </details>
  </div>
</header>

<script>
  // Close the mobile menu after choosing an in-page link.
  for (const menu of document.querySelectorAll<HTMLDetailsElement>('details[data-microsite-menu]')) {
    menu.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) menu.open = false;
    });
  }
</script>
