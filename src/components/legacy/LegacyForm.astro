---
/**
 * The old hard-coded forms, posting the same JSON payload as the old React forms to
 * /api/submit: { id, ...fields, Source }. Two layouts:
 *  - "landing": the dark contact form of the hotels / Coffee & Contracts pages (hotels.css)
 *  - "advisor": the Trusted Advisor conversation form (trusted-advisor.css)
 * Behaviour (legacy-form.ts): optional ?email= pre-fill, "Sending…" state, success message
 * on 2xx, error message on network errors and any other status (e.g. 502 when the
 * notification email fails).
 */
import { LEGACY_FORM_ID, type LegacyForm, type LegacyFormField } from '../../data/legacy/forms';
import LegacyField from './LegacyField.astro';
import Lines from './Lines.astro';

interface Props {
  form: LegacyForm;
  variant: 'landing' | 'advisor';
}
const { form, variant } = Astro.props;
const keys = Object.fromEntries(form.fields.map((f) => [f.name, f.payloadKey]));
const half = form.fields.filter((f) => f.width === 'half');
const full = form.fields.filter((f) => f.width === 'full');
const pairs: LegacyFormField[][] = [];
for (let i = 0; i < half.length; i += 2) pairs.push(half.slice(i, i + 2));

const data = {
  'data-legacy-form': '',
  'data-form-id': LEGACY_FORM_ID,
  'data-source': form.source,
  'data-keys': JSON.stringify(keys),
  'data-prefill-email': form.prefillEmailFromQuery ? '' : undefined,
  'data-success': form.successMessage,
  'data-error': form.errorMessage,
  'data-submitting': form.submittingLabel,
};
---

{
  variant === 'landing' ? (
    <form class="hm-contactForm" {...data}>
      <div class="hm-contactFormHeader">
        <h3>{form.heading}</h3>
        {form.responseNote && <span><Lines text={form.responseNote} /></span>}
      </div>
      <input class="hm-honeypot" name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <div class="hm-formGrid">
        {half.map((field) => <LegacyField field={field} />)}
      </div>
      {full.map((field) => <LegacyField field={field} class="hm-messageField" />)}
      <div class="hm-formFooter">
        <button type="submit" data-label>{form.submitLabel}</button>
        <p>{form.consent}</p>
      </div>
      <div class="hm-formSuccess" role="status" aria-live="polite" data-status data-success-class="hm-formSuccess" data-error-class="hm-formError"></div>
    </form>
  ) : (
    <form class="ta-form" {...data}>
      <input class="ta-honeypot" name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
      {pairs.map((pair) => <div class="ta-formPair">{pair.map((field) => <LegacyField field={field} />)}</div>)}
      {full.map((field) => <LegacyField field={field} />)}
      <div class="ta-formFooter">
        <button type="submit"><span data-label>{form.submitLabel}</span>{form.submitIcon && <span aria-hidden="true">{form.submitIcon}</span>}</button>
        <p>{form.consent}</p>
      </div>
      <div class="ta-formStatus" role="status" aria-live="polite" data-status data-status-wrap data-error-class="ta-formError"></div>
    </form>
  )
}

<script>
  import { initLegacyForms } from './legacy-form';
  initLegacyForms();
</script>
