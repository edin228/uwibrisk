---
/**
 * Footer of the old landing-page microsites (hotels, Coffee & Contracts).
 * Use in BaseLayout's footer slot: <MicrositeFooter slot="footer" brand={brand} />.
 */
import { Image } from 'astro:assets';
import logo from '../../assets/brand/uwib-wide-white.png';
import type { MicrositeBrand } from '../../data/legacy/hotels';
import { altFor } from '../../lib/alt';

interface Props {
  brand: MicrositeBrand;
}
const { brand } = Astro.props;
---

<footer class="hm-site hm-chrome hm-footer">
  <div class="hm-footerTop">
    <div class="hm-footerBrand">
      <a href={brand.home} aria-label={`${brand.label} home`}>
        <span class="hm-logo">
          <Image
            src={logo}
            alt={altFor('src/assets/brand/uwib-wide-white.png')}
            widths={[182, 364]}
            sizes="182px"
            class="hm-fill-contain"
            data-color
          />
        </span>
      </a>
      <p>{brand.tagline}</p>
    </div>
    <div class="hm-footerNav">
      {brand.footerColumns.map((column) => <div>{column.map((link) => <a href={link.href}>{link.label}</a>)}</div>)}
      <a href={brand.cta.href} class="hm-footerCta">{brand.cta.label} →</a>
    </div>
  </div>
  <div class="hm-footerBottom">
    <span>{brand.copyright}</span>
    <span>{brand.legalLinks.map((link, i) => <Fragment>{i > 0 && <span aria-hidden="true"> · </span>}<a href={link.href}>{link.label}</a></Fragment>)}</span>
  </div>
</footer>
