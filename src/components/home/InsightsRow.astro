---
import { Image } from 'astro:assets';
import { insights } from '../../data/home';
import { getPosts } from '../../lib/content';
import { shortDate, topicFor } from '../../lib/topics';
import TextLink from '../ui/TextLink.astro';

const posts = await getPosts();
const latest = posts.slice(0, 3);
---

<section class="insights" aria-labelledby="insights-heading">
  <div class="intro">
    <div class="intro-text">
      <p class="eyebrow">{insights.eyebrow}</p>
      <h2 id="insights-heading">{insights.heading}</h2>
      <p class="text">{insights.text}</p>
    </div>
    <TextLink href="/blog" rule="ink">All {posts.length} articles →</TextLink>
  </div>
  <ul class="posts">
    {
      latest.map((post) => (
        <li>
          <a href={`/blog/${post.id}`}>
            <Image src={post.data.heroImage} alt="" widths={[300, 600]} sizes="(max-width: 760px) 100vw, 294px" />
            <span class="meta">
              <span class="topic">{topicFor(post)}</span>
              <time datetime={post.data.pubDate.toISOString()}>{shortDate(post.data.pubDate)}</time>
            </span>
            <span class="title">{post.data.title}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .insights {
    display: flex;
    gap: 64px;
    padding: clamp(88px, 9.7vw, 140px) max(var(--gutter), calc((100vw - var(--container)) / 2)) clamp(88px, 10.4vw, 150px);
    background: var(--color-surface);
  }

  .intro {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    gap: 32px;
    flex-shrink: 0;
    width: var(--label-col);
  }

  .intro-text {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  h2 {
    font-size: clamp(36px, 1rem + 2.4vw, 48px);
    letter-spacing: -0.04em;
    line-height: 1.12;
  }

  .text {
    font-size: 15px;
    line-height: 25px;
  }

  .posts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    flex: 1;
    max-width: 948px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .posts li:nth-child(2) {
    padding-top: 56px;
  }

  .posts li:nth-child(3) {
    padding-top: 112px;
  }

  .posts a {
    display: flex;
    flex-direction: column;
    gap: 18px;
    color: inherit;
    text-decoration: none;
  }

  .posts img {
    width: 100%;
    aspect-ratio: 294 / 340;
    object-fit: cover;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .topic {
    color: var(--color-gold);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  time {
    color: #8c8c8c;
    font-size: 12px;
  }

  .title {
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 23px;
    letter-spacing: -0.015em;
    line-height: 29px;
  }

  .posts a:hover .title {
    text-decoration: underline;
    text-decoration-color: var(--color-mustard);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  @media (max-width: 1100px) {
    .insights {
      flex-direction: column;
      gap: 48px;
    }

    .intro {
      width: auto;
    }
  }

  @media (max-width: 760px) {
    .insights {
      padding-inline: 20px;
    }

    .posts {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .posts li,
    .posts li:nth-child(n) {
      padding: 20px 0;
      border-top: 1px solid var(--color-rule);
    }

    .posts li:first-child {
      padding-top: 0;
      border-top: 0;
    }

    .posts li:not(:first-child) img {
      display: none;
    }

    .posts li:first-child img {
      aspect-ratio: 4 / 3;
    }

    .posts a {
      gap: 10px;
    }

    .title {
      font-size: 20px;
      line-height: 26px;
    }
  }
</style>
