---
/**
 * Numbered link rows in the style of the homepage industry index, on a light background:
 * number, Lora title (italic on hover with a mustard rule), optional text, arrow.
 */
import { isExternal } from '../../lib/cards';

interface Item {
  title: string;
  href: string;
  text?: string | null | undefined;
}
interface Props {
  items: Item[];
  /** Show 01, 02, ... before each title. */
  numbered?: boolean;
  /** Title size. */
  size?: 'lg' | 'md';
}
const { items, numbered = true, size = 'lg' } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<ol class:list={['index-list', `size-${size}`, { numbered }]}>
  {
    items.map((item, i) => {
      const external = isExternal(item.href);
      return (
        <li>
          <a href={item.href} {...(external ? { target: '_blank', rel: 'noopener' } : {})}>
            {numbered && (
              <span class="num" aria-hidden="true">
                {pad(i + 1)}
              </span>
            )}
            <span class="main">
              <span class="name">
                {item.title}
                {external && <span class="visually-hidden"> (opens in a new tab)</span>}
              </span>
              {item.text && <span class="text">{item.text}</span>}
            </span>
            <span class="go" aria-hidden="true">
              {external ? '↗' : '→'}
            </span>
          </a>
        </li>
      );
    })
  }
</ol>

<style>
  .index-list {
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--color-rule);
    list-style: none;
  }

  li {
    border-top: 1px solid var(--color-rule);
  }

  a {
    display: flex;
    align-items: baseline;
    gap: 24px;
    padding-block: 22px;
    color: inherit;
    text-decoration: none;
  }

  .size-md a {
    padding-block: 16px;
  }

  .num {
    flex-shrink: 0;
    width: 32px;
    color: var(--color-faint);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .main {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
    min-width: 0;
  }

  .name {
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(24px, 1rem + 1vw, 30px);
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .size-md .name {
    font-size: 21px;
    letter-spacing: -0.015em;
    line-height: 28px;
  }

  .text {
    max-width: 640px;
    color: var(--color-body);
    font-size: 15px;
    line-height: 24px;
  }

  .go {
    flex-shrink: 0;
    color: var(--color-gold);
    font-size: 18px;
    transition: transform 0.2s ease;
  }

  a:hover .name {
    font-style: italic;
    text-decoration: underline;
    text-decoration-color: var(--color-mustard);
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  a:hover .num {
    color: var(--color-gold);
  }

  a:hover .go {
    transform: translateX(4px);
  }

  @media (max-width: 640px) {
    a {
      gap: 14px;
      padding-block: 18px;
    }

    .num {
      width: 22px;
    }

    .text {
      font-size: 14px;
      line-height: 22px;
    }
  }
</style>
