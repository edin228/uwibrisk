---
/** Team portrait card (color photo, name, role). Links to the bio page when there is one. */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  member: CollectionEntry<'team'>;
}
const { member } = Astro.props;
const { data } = member;
const Tag = data.hasTeamPage ? 'a' : 'div';
---

<Tag class="member" {...(data.hasTeamPage ? { href: `/team/${member.id}` } : {})}>
  <Image
    src={data.photo}
    alt={data.photoAlt}
    widths={[300, 600]}
    sizes="(max-width: 760px) 45vw, 297px"
    data-color
  />
  <span class="text">
    <span class="name">{data.name}</span>
    <span class="role">{data.role}</span>
  </span>
</Tag>

<style>
  .member {
    display: flex;
    flex-direction: column;
    gap: 14px;
    color: inherit;
    text-decoration: none;
  }

  img {
    width: 100%;
    aspect-ratio: 297 / 356;
    object-fit: cover;
    object-position: 50% 25%;
    background: var(--color-rule);
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .name {
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 22px;
    letter-spacing: -0.01em;
    line-height: 28px;
  }

  a:hover .name {
    text-decoration: underline;
    text-decoration-color: var(--color-mustard);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .role {
    color: var(--color-muted);
    font-size: 13px;
    line-height: 19px;
  }

  @media (max-width: 760px) {
    .member {
      gap: 10px;
    }

    .name {
      font-size: 18px;
      line-height: 23px;
    }

    .role {
      font-size: 12px;
      line-height: 17px;
    }
  }
</style>
