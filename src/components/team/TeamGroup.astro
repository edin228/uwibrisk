---
/** One group on the team listing: title + count in the label column, portrait grid beside it. */
import type { CollectionEntry } from 'astro:content';
import MemberCard from './MemberCard.astro';

interface Props {
  id: string;
  label: string;
  members: CollectionEntry<'team'>[];
  /** Extra bottom padding for the last group. */
  last?: boolean;
}
const { id, label, members, last = false } = Astro.props;
const headingId = `group-${id}-heading`;
---

<section id={`group-${id}`} class:list={['group', { last }]} aria-labelledby={headingId} data-group={id}>
  <div class="inner">
    <div class="group-label">
      <h2 id={headingId}>{label}</h2>
      <p class="count">{members.length === 1 ? '1 person' : `${members.length} people`}</p>
    </div>
    <ul class="grid">
      {
        members.map((m) => (
          <li>
            <MemberCard member={m} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .group {
    padding-bottom: clamp(64px, 6.7vw, 96px);
  }

  .group.last {
    padding-bottom: clamp(80px, 8.3vw, 120px);
  }

  .inner {
    display: flex;
    gap: 64px;
    max-width: calc(var(--container) + 2 * var(--gutter));
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .group-label,
  .grid {
    border-top: 1px solid var(--color-ink);
    padding-top: 24px;
  }

  .group-label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex-shrink: 0;
    width: var(--label-col);
  }

  h2 {
    font-size: 28px;
    letter-spacing: -0.02em;
    line-height: 34px;
  }

  .count {
    color: var(--color-faint);
    font-size: 13px;
    line-height: 18px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 48px 28px;
    flex: 1;
    min-width: 0;
    max-width: 948px;
    margin: 0;
    padding-left: 0;
    padding-right: 0;
    list-style: none;
  }

  @media (max-width: 1100px) {
    .inner {
      flex-direction: column;
      gap: 0;
    }

    .group-label {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      width: auto;
      padding-bottom: 24px;
    }

    .grid {
      max-width: none;
      border-top: 0;
      padding-top: 0;
    }
  }

  @media (max-width: 760px) {
    .group-label {
      padding-top: 18px;
      padding-bottom: 20px;
    }

    h2 {
      font-size: 24px;
      line-height: 30px;
    }

    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px 14px;
    }
  }
</style>
