---
/**
 * Grid of linked photo cards (quote cards, check-ups, featured programs): B&W photo,
 * Lora title, optional text, arrow. External links open in a new tab and show ↗.
 */
import { Image } from 'astro:assets';
import { isExternal, type Card } from '../lib/cards';

interface Props {
  cards: Card[];
  /** Columns on wide screens. */
  columns?: 2 | 3 | 4;
  /** Heading level of the card titles. */
  level?: 'h2' | 'h3';
}
const { cards, columns = 3, level: Title = 'h3' } = Astro.props;
const sizes = `(max-width: 640px) 100vw, (max-width: 860px) 50vw, ${Math.round(948 / columns)}px`;
---

<ul class="card-grid" style={`--cols: ${columns}`}>
  {
    cards.map((c) => {
      const external = isExternal(c.href);
      return (
        <li>
          <a href={c.href} {...(external ? { target: '_blank', rel: 'noopener' } : {})}>
            {c.image && (
              <span class="frame">
                <Image src={c.image} alt={c.imageAlt ?? ''} widths={[320, 480, 640]} sizes={sizes} />
              </span>
            )}
            <div class="body">
              <div class="head">
                <Title class="title">
                  {c.title}
                  {external && <span class="visually-hidden"> (opens in a new tab)</span>}
                </Title>
                <span class="go" aria-hidden="true">
                  {external ? '↗' : '→'}
                </span>
              </div>
              {c.text && <p class="text">{c.text}</p>}
            </div>
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .card-grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 40px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
  }

  a {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
    color: inherit;
    text-decoration: none;
  }

  .frame {
    display: block;
    overflow: hidden;
    background: var(--color-surface);
  }

  img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  a:hover img {
    transform: scale(1.03);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
  }

  .title {
    color: var(--color-ink);
    font-size: 23px;
    letter-spacing: -0.015em;
    line-height: 29px;
  }

  a:hover .title {
    text-decoration: underline;
    text-decoration-color: var(--color-mustard);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .text {
    color: var(--color-body);
    font-size: 14px;
    line-height: 22px;
  }

  .go {
    flex-shrink: 0;
    color: var(--color-gold);
    font-size: 18px;
    line-height: 29px;
    transition: transform 0.2s ease;
  }

  a:hover .go {
    transform: translateX(3px);
  }

  @media (max-width: 860px) {
    .card-grid {
      grid-template-columns: repeat(min(var(--cols), 2), minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .card-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }

    .title {
      font-size: 20px;
      line-height: 26px;
    }
  }
</style>
