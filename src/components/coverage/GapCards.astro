---
/** "What it doesn't cover / And what does.": label column beside linked cards (warm-gray band). */
import { isExternal } from './coverage';

interface Props {
  eyebrow: string;
  heading: string;
  intro?: string | undefined;
  items: { eyebrow: string; title: string; text: string; href: string }[];
}
const { eyebrow, heading, intro, items } = Astro.props;
---

<section class="gaps" aria-labelledby="gaps-heading">
  <div class="inner">
    <div class="label-col">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="gaps-heading">{heading}</h2>
      {intro && <p class="intro">{intro}</p>}
    </div>
    <ul class="grid">
      {
        items.map((item) => {
          const external = isExternal(item.href);
          return (
            <li>
              <a href={item.href} {...(external ? { target: '_blank', rel: 'noopener' } : {})}>
                <span class="top">
                  <span class="kicker">{item.eyebrow}</span>
                  <span class="title">{item.title}</span>
                </span>
                <span class="bottom">
                  <span class="text">{item.text}</span>
                  <span class="arrow" aria-hidden="true">
                    {external ? '↗' : '→'}
                  </span>
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  h2,
  h3 {
    text-wrap: pretty;
  }

  .gaps {
    padding-block: clamp(80px, 8.3vw, 120px) clamp(80px, 9vw, 130px);
    background: var(--color-surface);
  }

  .inner {
    display: flex;
    gap: 64px;
    max-width: calc(var(--container) + 2 * var(--gutter));
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .label-col {
    display: flex;
    flex-direction: column;
    gap: 18px;
    flex-shrink: 0;
    width: var(--label-col);
  }

  h2 {
    font-size: clamp(30px, 1rem + 1.4vw, 36px);
    letter-spacing: -0.03em;
    line-height: 1.17;
  }

  .intro {
    font-size: 15px;
    line-height: 25px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    flex: 1;
    max-width: 948px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
    height: 100%;
    padding: 28px;
    border-top: 3px solid transparent;
    background: var(--color-paper);
    text-decoration: none;
    transition: border-color 0.15s ease;
  }

  a:hover {
    border-top-color: var(--color-mustard);
  }

  .top {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .kicker {
    color: var(--color-faint);
    font-size: 12px;
    font-weight: 700;
    line-height: 16px;
  }

  .title {
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 26px;
    letter-spacing: -0.02em;
    line-height: 32px;
  }

  .bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .text {
    color: var(--color-body);
    font-size: 14px;
    line-height: 22px;
  }

  .arrow {
    flex-shrink: 0;
    color: var(--color-gold);
    font-size: 18px;
    line-height: 18px;
    transition: transform 0.15s ease;
  }

  a:hover .arrow {
    transform: translateX(3px);
  }

  @media (max-width: 1100px) {
    .inner {
      flex-direction: column;
      gap: 32px;
    }

    .label-col {
      width: auto;
      max-width: 560px;
    }
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    a {
      padding: 24px;
    }

    .title {
      font-size: 23px;
      line-height: 29px;
    }
  }
</style>
