---
/** Article page. Design: Paper "Blog post — Desktop". */
import { Image } from 'astro:assets';
import { type CollectionEntry, getEntry, render } from 'astro:content';
import AuthorBio from '../../components/blog/AuthorBio.astro';
import PostCard from '../../components/blog/PostCard.astro';
import ShareLinks from '../../components/blog/ShareLinks.astro';
import { authorHref } from '../../components/blog/authors';
import Callout from '../../components/Callout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import TextLink from '../../components/ui/TextLink.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getPosts } from '../../lib/content';
import { topicFor, topicInfo } from '../../lib/topics';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => {
    // Keep reading: newest posts on the same topic, topped up with the newest overall.
    const others = posts.filter((p) => p.id !== post.id);
    const topic = topicFor(post);
    const sameTopic = others.filter((p) => topicFor(p) === topic);
    const related = [...sameTopic, ...others.filter((p) => !sameTopic.includes(p))].slice(0, 3);
    return { params: { slug: post.id }, props: { post, related } };
  });
}

interface Props {
  post: CollectionEntry<'blog'>;
  related: CollectionEntry<'blog'>[];
}

const { post, related } = Astro.props;
const { Content, headings } = await render(post);
const author = post.data.author ? await getEntry(post.data.author) : undefined;
const authorLink = author ? authorHref(author) : undefined;
const topic = topicInfo(post);

const words = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 230));

// "In this article": the top heading level used in the body (h1s in post bodies are skipped).
const bodyHeadings = headings.filter((h) => h.depth > 1);
const tocDepth = Math.min(...bodyHeadings.map((h) => h.depth));
const toc = bodyHeadings.filter((h) => h.depth === tocDepth);

const url = new URL(`/blog/${post.id}`, Astro.site).toString();
---

<SiteLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.heroImage}
  type="article"
  publishedTime={post.data.pubDate}
  searchable
>
  <article class="post">
    <header class="head container">
      <nav class="crumbs" aria-label="Breadcrumb" data-pagefind-ignore>
        <ol>
          <li><a href="/blog">Insights</a></li>
          <li><a href={`/blog?topic=${topic.slug}`} class="current-topic">{topic.name}</a></li>
        </ol>
      </nav>
      <div class="head-main">
        <h1>{post.data.title}</h1>
        <p class="lead">{post.data.description}</p>
        <div class="byline">
          {
            author && (
              <Image
                src={author.data.photo}
                alt=""
                widths={[44, 88]}
                sizes="44px"
                class="avatar"
                data-color
                loading="eager"
              />
            )
          }
          <div class="byline-text">
            {
              author && (
                <p class="byline-name">
                  {authorLink ? <a href={authorLink}>{author.data.name}</a> : author.data.name}
                </p>
              )
            }
            <p class="byline-meta">
              {author && <>{author.data.role} · </>}
              <FormattedDate date={post.data.pubDate} format="short" /> · {minutes} min read
            </p>
          </div>
        </div>
      </div>
    </header>

    <div class="container">
      <Image
        src={post.data.heroImage}
        alt={post.data.heroAlt}
        widths={[640, 960, 1312, 1920, 2624]}
        sizes="(max-width: 1440px) calc(100vw - 2 * var(--gutter)), 1312px"
        class="hero"
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <div class="body container">
      <aside class="side" data-pagefind-ignore>
        {
          toc.length >= 2 && (
            <nav class="toc" aria-labelledby="toc-label">
              <p class="side-label" id="toc-label">
                In this article
              </p>
              <ol>
                {toc.map((h) => (
                  <li>
                    <a href={`#${h.slug}`} data-toc-link={h.slug}>
                      {h.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
        <div class="share-block">
          <p class="side-label">Share</p>
          <ShareLinks url={url} title={post.data.title} />
        </div>
      </aside>

      <div class="main">
        <div class="article-body" data-article-body>
          <Content components={{ Callout }} />
        </div>
        {author && <AuthorBio author={author} />}
      </div>
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="related" aria-labelledby="related-heading" data-pagefind-ignore>
        <div class="container">
          <div class="related-head">
            <h2 id="related-heading">Keep reading</h2>
            <TextLink href="/blog" rule="ink">
              All articles →
            </TextLink>
          </div>
          <ul class="related-grid">
            {related.map((p) => (
              <li>
                <PostCard post={p} headingLevel="h3" />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</SiteLayout>

<script>
  // Highlight the section currently being read in "In this article".
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
  const targets = links
    .map((a) => document.getElementById(a.dataset.tocLink ?? ''))
    .filter((el): el is HTMLElement => el !== null);
  if (targets.length) {
    let frame = 0;
    const update = () => {
      frame = 0;
      // The active section is the last heading above the reading line.
      let active = targets[0]?.id;
      for (const t of targets) if (t.getBoundingClientRect().top < window.innerHeight * 0.3) active = t.id;
      for (const a of links) a.classList.toggle('is-active', a.dataset.tocLink === active);
    };
    addEventListener('scroll', () => (frame ||= requestAnimationFrame(update)), { passive: true });
    update();
  }
</script>

<style>
  /* Header: label column (breadcrumb) + title column */
  .head {
    display: flex;
    gap: 64px;
    padding-top: clamp(56px, 6.7vw, 96px);
    padding-bottom: 56px;
  }

  .crumbs {
    flex-shrink: 0;
    width: var(--label-col);
    padding-top: 10px;
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    margin: 0;
    padding: 0;
    font-size: 12px;
    line-height: 16px;
    list-style: none;
  }

  .crumbs li + li::before {
    content: '/';
    margin-right: 10px;
    color: #b4b4b4;
  }

  .crumbs a {
    color: var(--color-muted);
    font-weight: 600;
    text-decoration: none;
  }

  .crumbs a.current-topic {
    color: var(--color-gold);
    font-weight: 700;
  }

  .crumbs a:hover {
    text-decoration: underline;
  }

  .head-main {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 26px;
    min-width: 0;
    max-width: 948px;
  }

  h1 {
    font-size: clamp(40px, 1.4rem + 3.4vw, 68px);
    letter-spacing: -0.045em;
    line-height: 1.06;
    text-wrap: balance;
  }

  .lead {
    max-width: 760px;
    color: var(--color-body);
    font-size: 19px;
    line-height: 30px;
  }

  .byline {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-top: 6px;
  }

  .byline :global(.avatar) {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-rule);
    object-fit: cover;
    object-position: 50% 25%;
  }

  .byline-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .byline-name {
    color: var(--color-ink);
    font-size: 14px;
    font-weight: 700;
    line-height: 18px;
  }

  .byline-name a {
    color: inherit;
    text-decoration: none;
  }

  .byline-name a:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-mustard);
    text-underline-offset: 3px;
  }

  .byline-meta {
    color: var(--color-muted);
    font-size: 13px;
    line-height: 18px;
  }

  .container :global(.hero) {
    width: 100%;
    aspect-ratio: 1312 / 620;
    object-fit: cover;
    object-position: 50% 55%;
  }

  /* Body: sticky sidebar + 700px text column */
  .body {
    display: flex;
    gap: 64px;
    padding-top: 80px;
    padding-bottom: clamp(88px, 8.3vw, 120px);
  }

  .side {
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    gap: 36px;
    align-self: flex-start;
    position: sticky;
    top: 32px;
    width: var(--label-col);
    max-height: calc(100vh - 64px);
    overflow-y: auto;
  }

  .side-label {
    margin-bottom: 12px;
    color: var(--color-gold);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    line-height: 14px;
    text-transform: uppercase;
  }

  .toc ol {
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--color-rule);
    list-style: none;
  }

  .toc a {
    display: block;
    margin-left: -1px;
    padding: 7px 0 7px 14px;
    border-left: 2px solid transparent;
    color: var(--color-muted);
    font-size: 14px;
    line-height: 20px;
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--color-ink);
  }

  .toc a.is-active {
    border-left-color: var(--color-ink);
    color: var(--color-ink);
    font-weight: 600;
  }

  .main {
    display: flex;
    flex-direction: column;
    gap: clamp(64px, 7vw, 96px);
    flex: 1;
    min-width: 0;
    max-width: 700px;
  }

  /* Article typography (Markdown output) */
  .article-body {
    display: flex;
    flex-direction: column;
    gap: 26px;
    color: #222;
    font-family: var(--font-display);
    font-size: 20px;
    line-height: 34px;
    overflow-wrap: break-word;
  }

  .article-body > :global(*) {
    margin: 0;
  }

  .article-body :global(h1),
  .article-body :global(h2) {
    padding-top: 22px;
    font-size: clamp(28px, 1rem + 1.4vw, 36px);
    letter-spacing: -0.03em;
    line-height: 1.22;
  }

  .article-body :global(h3) {
    padding-top: 12px;
    font-size: clamp(23px, 1rem + 0.6vw, 26px);
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .article-body :global(h4),
  .article-body :global(h5),
  .article-body :global(h6) {
    padding-top: 8px;
    font-family: var(--font-sans);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.4;
  }

  .article-body :global(:is(h1, h2, h3, h4) strong) {
    font-weight: inherit;
  }

  .article-body :global(:is(h1, h2, h3, h4)) {
    scroll-margin-top: 32px;
  }

  .article-body :global(strong) {
    color: var(--color-ink);
    font-weight: 600;
  }

  .article-body :global(a) {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-mustard);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .article-body :global(a:hover) {
    text-decoration-thickness: 2px;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    padding-left: 1.25em;
  }

  .article-body :global(li + li) {
    margin-top: 8px;
  }

  .article-body :global(li > :is(ul, ol)) {
    margin-top: 8px;
  }

  .article-body :global(li > p) {
    margin: 0;
  }

  .article-body :global(li::marker) {
    color: var(--color-gold);
  }

  .article-body :global(blockquote) {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 4px 0 4px 26px;
    border-left: 3px solid var(--color-mustard);
    color: var(--color-ink);
    font-size: 26px;
    font-style: italic;
    letter-spacing: -0.01em;
    line-height: 36px;
  }

  .article-body :global(blockquote p) {
    margin: 0;
  }

  .article-body :global(img) {
    width: 100%;
    height: auto;
  }

  .article-body :global(hr) {
    width: 100%;
    border: 0;
    border-top: 1px solid var(--color-rule);
  }

  .article-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    border-top: 2px solid var(--color-ink);
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 22px;
  }

  .article-body :global(th),
  .article-body :global(td) {
    padding: 16px 16px 16px 0;
    border-bottom: 1px solid var(--color-rule);
    color: var(--color-body);
    text-align: left;
    vertical-align: top;
  }

  .article-body :global(th) {
    color: var(--color-ink);
    font-weight: 600;
  }

  .article-body :global(td:first-child) {
    color: var(--color-ink);
    font-weight: 600;
  }

  .article-body :global(code) {
    font-size: 0.85em;
  }

  /* Keep reading */
  .related {
    padding-block: clamp(80px, 7.6vw, 110px) clamp(88px, 8.3vw, 120px);
    background: var(--color-surface);
  }

  .related-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    margin-bottom: 40px;
  }

  .related-head h2 {
    font-size: clamp(32px, 1rem + 1.6vw, 40px);
    letter-spacing: -0.035em;
    line-height: 1.15;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 48px 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .related-grid :global(.card) {
    gap: 16px;
  }

  @media (max-width: 1100px) {
    .head {
      flex-direction: column;
      gap: 24px;
    }

    .crumbs {
      width: auto;
      padding-top: 0;
    }

    .body {
      gap: 48px;
      padding-top: 64px;
    }

    .side {
      width: 220px;
    }
  }

  @media (max-width: 900px) {
    .body {
      flex-direction: column;
      padding-top: 56px;
    }

    .side {
      position: static;
      width: auto;
      max-width: 700px;
      max-height: none;
      overflow: visible;
    }
  }

  @media (max-width: 900px) {
    .related-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 48px 24px;
    }

    .related-grid li:nth-child(3) {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .head {
      padding-bottom: 40px;
    }

    .lead {
      font-size: 17px;
      line-height: 27px;
    }

    .container :global(.hero) {
      aspect-ratio: 4 / 3;
    }

    .body {
      padding-top: 40px;
    }

    .article-body {
      gap: 22px;
      font-size: 18px;
      line-height: 30px;
    }

    .article-body :global(blockquote) {
      padding-left: 20px;
      font-size: 22px;
      line-height: 31px;
    }

    .related-grid {
      grid-template-columns: 1fr;
    }

    .related-grid li:nth-child(3) {
      display: block;
    }

    .related-head {
      flex-wrap: wrap;
    }
  }
</style>
