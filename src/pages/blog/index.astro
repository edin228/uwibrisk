---
import { Image } from 'astro:assets';
import FormattedDate from '../../components/FormattedDate.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts } from '../../lib/content';

const posts = await getPosts();
---

<BaseLayout title="Blog" description="Insurance and risk management insights from UWIB Risk.">
  <section class="container">
    <h1>Blog</h1>
    <ul class="posts">
      {
        posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}`}>
              <Image src={post.data.heroImage} alt={post.data.heroAlt} width={480} />
              <h2>{post.data.title}</h2>
            </a>
            <p class="label">
              <FormattedDate date={post.data.pubDate} />
            </p>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .posts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 40px;
    padding: 0;
    list-style: none;
  }
  .posts a {
    color: inherit;
    text-decoration: none;
  }
  .posts img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .posts h2 {
    font-size: var(--text-h4);
  }
</style>
