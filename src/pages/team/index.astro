---
import { getEntry } from 'astro:content';
import TeamGroup from '../../components/team/TeamGroup.astro';
import TeamIntro from '../../components/team/TeamIntro.astro';
import { capitalize, curly, groupTeam, listJoin, numberWord } from '../../components/team/team';
import { team as teamCopy } from '../../data/home';
import { siteOffices } from '../../data/site';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getTeam } from '../../lib/content';

const members = await getTeam();
const groups = groupTeam(members);
const page = await getEntry('pages', 'team');

const offices = listJoin(siteOffices.map((o) => curly(o.label)));
const lead = `${capitalize(numberWord(members.length))} people across ${offices}. Every client has an advisor and a service team they can reach by name.`;
---

<SiteLayout title={page?.data.title ?? 'Our Team'} description={lead}>
  <TeamIntro eyebrow="Our team" heading={teamCopy.heading}>
    <p>{lead}</p>
    <nav slot="after" class="filters" aria-label="Filter the team by group">
      <a href="#main" class="chip" aria-current="true" data-filter="all">Everyone</a>
      {
        groups.map((g) => (
          <a href={`#group-${g.id}`} class="chip" data-filter={g.id}>
            {g.label}
          </a>
        ))
      }
    </nav>
  </TeamIntro>

  <div class="groups" data-groups>
    {groups.map((g, i) => <TeamGroup id={g.id} label={g.label} members={g.members} last={i === groups.length - 1} />)}
  </div>
  <p class="visually-hidden" aria-live="polite" data-filter-status></p>
</SiteLayout>

<script>
  // Progressive enhancement: the chips are anchor links; with JS they filter the groups.
  const chips = document.querySelectorAll<HTMLAnchorElement>('.filters [data-filter]');
  const groups = document.querySelectorAll<HTMLElement>('[data-groups] [data-group]');
  const status = document.querySelector<HTMLElement>('[data-filter-status]');
  for (const chip of chips) {
    chip.addEventListener('click', (event) => {
      event.preventDefault();
      const filter = chip.dataset.filter ?? 'all';
      for (const c of chips) {
        if (c === chip) c.setAttribute('aria-current', 'true');
        else c.removeAttribute('aria-current');
      }
      let shown = 0;
      for (const g of groups) {
        const visible = filter === 'all' || g.dataset.group === filter;
        g.hidden = !visible;
        if (visible) shown += g.querySelectorAll('li').length;
      }
      if (status) status.textContent = `Showing ${shown} ${shown === 1 ? 'person' : 'people'}`;
    });
  }
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 12px;
  }

  .chip {
    padding: 9px 16px;
    border: 1px solid #d6d6d6;
    color: var(--color-ink);
    font-size: 13px;
    font-weight: 600;
    line-height: 16px;
    text-decoration: none;
    white-space: nowrap;
  }

  .chip:hover {
    border-color: var(--color-ink);
  }

  .chip[aria-current] {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-paper);
    font-weight: 700;
  }

  @media (max-width: 760px) {
    .filters {
      flex-wrap: nowrap;
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      overflow-x: auto;
      scrollbar-width: none;
    }

    .filters::-webkit-scrollbar {
      display: none;
    }
  }
</style>
