---
/** /waiver: demo of the Waiver Electronic "sign your waiver" tab (not indexed). */
import PageIntro from '../components/content/PageIntro.astro';
import { meta, text, waiverTab } from '../data/legacy/waiver';
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title={meta.title} description={meta.description} noindex closing={false}>
  <PageIntro title={meta.title} lead={`${text}.`} crumbs={[{ label: 'Home', href: '/' }, { label: meta.title }]} />
  <div {...waiverTab.attributes}></div>
  <script is:inline src={waiverTab.scriptSrc}></script>
</SiteLayout>
