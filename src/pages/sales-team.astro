---
import { Image } from 'astro:assets';
import CardGrid from '../components/CardGrid.astro';
import { heading, intro, meta, programsHeading, quoteCardsHeading } from '../data/legacy/sales-team';
import BaseLayout from '../layouts/BaseLayout.astro';
import { programCards, quoteCards } from '../lib/cards';
import { getTeam } from '../lib/content';
const producers = (await getTeam()).filter((m) => m.data.isProducer);
---

<BaseLayout title={meta.title} description={meta.description}>
  <div class="container">
    <h2>{heading}</h2>
    <ul class="producers">
      {
        producers.map((m) => (
          <li>
            <a href={`/team/${m.id}`}>
              <Image src={m.data.motionPhotos[0]?.src ?? m.data.photo} alt={m.data.motionPhotos[0]?.alt ?? m.data.photoAlt} width={240} />
              <strong>{m.data.name}</strong>
            </a>
            <p class="label">{m.data.role}</p>
          </li>
        ))
      }
    </ul>
    {intro.map((p) => <p>{p.link ? <>{p.text.split(p.link.label)[0]}<a href={p.link.href}>{p.link.label}</a>{p.text.split(p.link.label)[1]}</> : p.text}</p>)}
    <h1>{programsHeading}</h1>
    <CardGrid cards={await programCards()} />
    <h1>{quoteCardsHeading}</h1>
    <CardGrid cards={await quoteCards()} />
  </div>
</BaseLayout>

<style>
  .producers {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    padding: 0;
    list-style: none;
  }
</style>
