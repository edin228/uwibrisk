---
/** /sales-team: producers only (isProducer), styled like the /team listing. */
import { getEntry } from 'astro:content';
import TeamGroup from '../components/team/TeamGroup.astro';
import TeamIntro from '../components/team/TeamIntro.astro';
import TextLink from '../components/ui/TextLink.astro';
import { heading, intro, meta, moreLinks } from '../data/legacy/sales-team';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getTeam } from '../lib/content';

const page = await getEntry('pages', 'sales-team');
const producers = (await getTeam()).filter((m) => m.data.isProducer);
const links = [...moreLinks, { label: 'Meet the team', href: '/team' }];
---

<SiteLayout title={meta.title} description={meta.description}>
  <TeamIntro eyebrow="Our team" heading={page?.data.title ?? heading}>
    {
      intro.map((p) => {
        const [before, after] = p.link ? p.text.split(p.link.label) : [p.text];
        return (
          <p>
            {before}
            {p.link && (
              <a href={p.link.href} target="_blank" rel="noopener">
                {p.link.label}
              </a>
            )}
            {after}
          </p>
        );
      })
    }
    <ul slot="after" class="links">
      {
        links.map((l) => (
          <li>
            <TextLink href={l.href}>{l.label} →</TextLink>
          </li>
        ))
      }
    </ul>
  </TeamIntro>

  <TeamGroup id="sales" label={meta.title} members={producers} last />
</SiteLayout>

<style>
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin: 0;
    padding: 4px 0 0;
    list-style: none;
  }
</style>
