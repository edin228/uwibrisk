---
/**
 * Top-level CMS URLs that keep their old path. This route only picks the
 * template; each template owns its layout:
 *   pages collection (rich text)  -> components/templates/PageTemplate.astro
 *   Jotform/embed form pages      -> components/templates/FormTemplate.astro
 *   component landing pages       -> components/templates/LandingTemplate.astro
 */
import { type CollectionEntry, getCollection } from 'astro:content';
import FormTemplate from '../components/templates/FormTemplate.astro';
import LandingTemplate from '../components/templates/LandingTemplate.astro';
import PageTemplate from '../components/templates/PageTemplate.astro';
import { type FormPage, forms } from '../data/forms';

type Entry =
  | { kind: 'page'; page: CollectionEntry<'pages'> }
  | { kind: 'form'; form: FormPage }
  | { kind: 'landing'; landing: CollectionEntry<'landing'>; form: FormPage | undefined };

export async function getStaticPaths() {
  // Slugs with their own route file (getStaticPaths cannot see module-level values).
  const DEDICATED_ROUTES = new Set(['contact']);
  const [pages, landings] = await Promise.all([
    getCollection('pages', ({ data }) => data.hasBody && !DEDICATED_ROUTES.has(data.slug)),
    getCollection('landing'),
  ]);
  const landingSlugs = new Set(landings.map((l) => l.data.slug));
  const paths: { params: { slug: string }; props: Entry }[] = [
    ...pages.map((page) => ({ params: { slug: page.data.slug }, props: { kind: 'page' as const, page } })),
    ...forms
      .filter((form) => !landingSlugs.has(form.slug))
      .map((form) => ({ params: { slug: form.slug }, props: { kind: 'form' as const, form } })),
    ...landings.map((landing) => ({
      params: { slug: landing.data.slug },
      props: {
        kind: 'landing' as const,
        landing,
        form: forms.find((f) => f.slug === landing.data.formEmbed),
      },
    })),
  ];
  return paths;
}

const entry = Astro.props as Entry;
---

{entry.kind === 'page' && <PageTemplate page={entry.page} />}
{entry.kind === 'form' && <FormTemplate form={entry.form} />}
{entry.kind === 'landing' && <LandingTemplate landing={entry.landing} form={entry.form} />}
