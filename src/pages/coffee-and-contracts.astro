---
import LegacyForm from '../components/legacy/LegacyForm.astro';
import LegacyImg from '../components/legacy/LegacyImg.astro';
import MicrositeShell from '../components/legacy/MicrositeShell.astro';
import * as c from '../data/legacy/coffee-and-contracts';
import { coffeeContactForm } from '../data/legacy/forms';
import BaseLayout from '../layouts/BaseLayout.astro';
const { hero, about, differentiators, whoWeServe, approach, team, contact } = c;
---

<BaseLayout title={c.meta.title} description={c.meta.description} image={hero.image.src} searchable>
  <MicrositeShell brand={c.brand} home="/coffee-and-contracts">
    <div class="container">
      <p class="label">{hero.eyebrow}</p>
      <h1>{hero.heading}</h1>
      <p>{hero.text}</p>
      <p><a href={hero.primaryCta.href}>{hero.primaryCta.label}</a> · <a href={hero.secondaryCta.href}>{hero.secondaryCta.label}</a></p>
      <p class="label">{hero.trust}</p>
      <LegacyImg image={hero.image} />
      <p class="label">{hero.imageCaption}</p>
      <ul>{c.credibility.map((x) => <li>{x}</li>)}</ul>
      <section id="about">
        <p class="label">{about.eyebrow}</p><h2>{about.heading}</h2><p>{about.text}</p>
        <LegacyImg image={about.image} />
        {about.points.map((p) => <article><h3>{p.number} {p.title}</h3><p>{p.text}</p></article>)}
      </section>
      <section>
        <LegacyImg image={differentiators.image} />
        <p class="label">{differentiators.eyebrow}</p><h2>{differentiators.heading}</h2><p>{differentiators.text}</p>
        {differentiators.items.map((p) => <article><h3>{p.number} {p.title}</h3><p>{p.text}</p></article>)}
      </section>
      <section id="who-we-serve">
        <p class="label">{whoWeServe.eyebrow}</p><h2>{whoWeServe.heading}</h2><p>{whoWeServe.text}</p>
        {whoWeServe.items.map((p) => <article><h3>{p.number} {p.title}</h3><p>{p.text}</p></article>)}
      </section>
      <section id="approach">
        <p class="label">{approach.eyebrow}</p><h2>{approach.heading}</h2>
        {approach.steps.map((s) => <article><p class="label">{s.label}</p><h3>{s.title}</h3><p>{s.text}</p></article>)}
      </section>
      <section id="team">
        <p class="label">{team.eyebrow}</p><h2>{team.heading}</h2><p>{team.text}</p>
        <article>
          <LegacyImg image={team.lead.image} width={320} />
          <h3>{team.lead.name}</h3><p class="label">{team.lead.role}</p><p>{team.lead.bio}</p>
          <p><a href={`mailto:${team.lead.email}`}>{team.lead.email}</a> · <a href={team.lead.phoneHref}>{team.lead.phone}</a></p>
        </article>
        <p class="label">{team.serviceEyebrow}</p><h3>{team.serviceHeading}</h3>
        {team.serviceTeam.map((m) => <article><LegacyImg image={m} width={240} /><h4>{m.name}</h4><p class="label">{m.role}</p></article>)}
        <p>{team.serviceText}</p>
      </section>
      <section id="contact">
        <p class="label">{contact.eyebrow}</p><h2>{contact.heading}</h2><p>{contact.text}</p>
        <p><strong>{contact.direct.label}</strong> <a href={`mailto:${contact.direct.email}`}>{contact.direct.email}</a> · <a href={contact.direct.phoneHref}>{contact.direct.phone}</a></p>
        <LegacyImg image={contact.image} width={480} />
        <LegacyForm form={coffeeContactForm} />
      </section>
    </div>
  </MicrositeShell>
</BaseLayout>
