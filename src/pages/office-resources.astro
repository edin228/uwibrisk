---
/** /office-resources: logins and tools for the UWIB team, grouped by category. */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import PageIntro from '../components/content/PageIntro.astro';
import LabelSection from '../components/site/LabelSection.astro';
import { listingPages } from '../data/legacy/listing-pages';
import SiteLayout from '../layouts/SiteLayout.astro';
import { isExternal } from '../lib/cards';

const copy = listingPages['office-resources'];
const resources = (await getCollection('officeResources')).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99) || a.data.title.localeCompare(b.data.title),
);
const categories = [...new Set(resources.map((r) => r.data.category))].sort((a, b) => a.localeCompare(b));
const groups = categories.map((category) => ({
  category,
  items: resources.filter((r) => r.data.category === category),
}));
---

<SiteLayout title={copy.title} description={copy.description} closing={false}>
  <PageIntro title={copy.heading} crumbs={[{ label: 'Resources', href: '/resources' }, { label: copy.heading }]} flush />

  {
    groups.map((g, i) => (
      <LabelSection eyebrow={g.category} intro={`${g.items.length} links`} space="compact" class={i === groups.length - 1 ? 'last' : undefined}>
        <ul class="tiles">
          {g.items.map((r) => {
            const external = isExternal(r.data.link);
            return (
              <li>
                <a href={r.data.link} {...(external ? { target: '_blank', rel: 'noopener' } : {})}>
                  <span class="logo">
                    <Image src={r.data.image} alt={r.data.imageAlt} width={240} />
                  </span>
                  <span class="title">
                    {r.data.title}
                    <span aria-hidden="true">{external ? ' ↗' : ' →'}</span>
                    {external && <span class="visually-hidden"> (opens in a new tab)</span>}
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      </LabelSection>
    ))
  }
</SiteLayout>

<style>
  :global(section.last.last) {
    padding-bottom: clamp(80px, 8.3vw, 120px);
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-rule);
    border-left: 1px solid var(--color-rule);
    list-style: none;
  }

  li {
    display: flex;
    border-right: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
  }

  a {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
    padding: 20px;
    color: inherit;
    text-decoration: none;
  }

  a:hover {
    background: var(--color-surface);
  }

  .logo {
    display: flex;
    align-items: center;
    height: 48px;
  }

  .logo img {
    width: auto;
    max-width: min(100%, 150px);
    max-height: 40px;
    object-fit: contain;
  }

  .title {
    color: var(--color-ink);
    font-size: 14px;
    font-weight: 600;
    line-height: 20px;
  }

  @media (max-width: 1100px) {
    .tiles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    a {
      padding: 16px;
    }
  }
</style>
