---
import ProgramNav from '../../components/site/ProgramNav.astro';
import { brand, meta, whyPage } from '../../data/legacy/hotels';
import SiteLayout from '../../layouts/SiteLayout.astro';
import '../../styles/microsites/hotels.css';

const { hero, pointOfView, intro, points, stages, cta } = whyPage;
---

<SiteLayout title={meta.why.title} description={meta.why.description} searchable section="/programs" closing={false}>
  <ProgramNav {...brand} />
  <div class="hm-site">
    <section class="hm-whyHero">
      <div>
        <div class="hm-eyebrow">{hero.eyebrow}</div>
        <h1>{hero.heading}</h1>
        <p>{hero.text}</p>
      </div>
      <aside>
        <div class="hm-eyebrow hm-eyebrowLight">{pointOfView.eyebrow}</div>
        <h2>{pointOfView.heading}</h2>
        <p>{pointOfView.text}</p>
      </aside>
    </section>

    <section class="hm-whyPointsSection">
      <div class="hm-sectionIntroSplit">
        <h2>{intro.heading}</h2>
        <p>{intro.text}</p>
      </div>
      <div class="hm-whyPoints">
        {
          points.map((point) => (
            <article>
              <span>{point.number}</span>
              <div>
                <h3>{point.title}</h3>
                <p>{point.text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="hm-advisorStages">
      <div>
        <div class="hm-eyebrow hm-eyebrowLight">{stages.eyebrow}</div>
        <h2>{stages.heading}</h2>
      </div>
      <div class="hm-stageGrid">
        {
          stages.items.map((stage) => (
            <article>
              <span>{stage.number}</span>
              <h3>{stage.title}</h3>
              <p>{stage.text}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="hm-supportingCta">
      <h2>{cta.heading}</h2>
      <a href={cta.href} class="hm-button">{cta.label}</a>
    </section>
  </div>
</SiteLayout>
