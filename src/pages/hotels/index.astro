---
import LegacyForm from '../../components/legacy/LegacyForm.astro';
import LegacyImg from '../../components/legacy/LegacyImg.astro';
import Lines from '../../components/legacy/Lines.astro';
import MicrositeFooter from '../../components/legacy/MicrositeFooter.astro';
import MicrositeHeader from '../../components/legacy/MicrositeHeader.astro';
import MicrositeIcon from '../../components/legacy/MicrositeIcon.astro';
import RiskBriefCover from '../../components/legacy/RiskBriefCover.astro';
import { hotelsContactForm } from '../../data/legacy/forms';
import { brand, coverageAreas, HOTEL_PATHS, landing, meta, serviceTeam } from '../../data/legacy/hotels';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/microsites/hotels.css';

const { hero, risks, briefFeature, coveragePreview, process, team, contact } = landing;
---

<BaseLayout title={meta.home.title} description={meta.home.description} canonical="/hotels" image={hero.image.src} searchable>
  <MicrositeHeader slot="header" brand={brand} />
  <div class="hm-site">
    <section class="hm-landingHero">
      <div class="hm-heroCopy">
        <div class="hm-eyebrow">{hero.eyebrow}</div>
        <h1><Lines text={hero.heading} /></h1>
        <p>{hero.text}</p>
        <div class="hm-heroActions">
          <a href={hero.primaryCta.href} class="hm-button">{hero.primaryCta.label}</a>
          <a href={hero.secondaryCta.href} class="hm-textLink">{hero.secondaryCta.label}</a>
        </div>
        <div class="hm-heroTrust"><span></span>{hero.trust}</div>
      </div>
      <div class="hm-heroImage">
        <LegacyImg image={hero.image} widths={[650, 954]} sizes="(max-width: 820px) 100vw, 650px" class="hm-fill" position="center center" priority />
        <span>{hero.imageCaption}</span>
      </div>
    </section>

    <section class="hm-credibilityStrip" aria-label={landing.credibilityLabel}>
      {landing.credibility.map((item) => <div>{item}</div>)}
    </section>

    <section class="hm-riskSection">
      <div class="hm-sectionIntroSplit">
        <div>
          <div class="hm-eyebrow">{risks.eyebrow}</div>
          <h2><Lines text={risks.heading} /></h2>
        </div>
        <p>{risks.text}</p>
      </div>
      <div class="hm-riskGrid">
        {
          risks.items.map((item) => (
            <article>
              <span class="hm-riskIcon"><MicrositeIcon type={item.icon} /></span>
              <span class="hm-itemNumber">{item.number}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="hm-briefFeature">
      <RiskBriefCover />
      <div class="hm-briefFeatureCopy">
        <div class="hm-eyebrow hm-eyebrowLight">{briefFeature.eyebrow}</div>
        <h2>{briefFeature.heading}</h2>
        <p>{briefFeature.text}</p>
        <div class="hm-topicTags">{briefFeature.topics.map((topic) => <span>{topic}</span>)}</div>
        <a href={briefFeature.cta.href} class="hm-yellowLink">{briefFeature.cta.label}</a>
      </div>
    </section>

    <section class="hm-coveragePreview">
      <div class="hm-coveragePreviewIntro">
        <div class="hm-eyebrow">{coveragePreview.eyebrow}</div>
        <h2>{coveragePreview.heading}</h2>
        <p>{coveragePreview.text}</p>
        <span class="hm-yellowRule"></span>
      </div>
      <div class="hm-coveragePreviewList">
        {
          coverageAreas.map((area) => (
            <a href={`${HOTEL_PATHS.coverage}#${area.id}`}>
              <span>{area.number}</span>
              <div>
                <h3>{area.title}</h3>
                <p>{area.includes.join(', ')}</p>
              </div>
              <strong aria-hidden="true">→</strong>
            </a>
          ))
        }
      </div>
    </section>

    <section class="hm-processSection">
      <div class="hm-processIntro">
        <div class="hm-eyebrow">{process.eyebrow}</div>
        <h2>{process.heading}</h2>
      </div>
      <div class="hm-processGrid">
        {
          process.steps.map((step) => (
            <article>
              <span>{step.label}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="hm-teamSection" id="team">
      <div class="hm-teamIntro">
        <div>
          <div class="hm-eyebrow hm-eyebrowLight">{team.eyebrow}</div>
          <h2>{team.heading}</h2>
        </div>
        <p>{team.text}</p>
      </div>
      <div class="hm-teamRoster">
        <article class="hm-ericCard">
          <div class="hm-ericPhoto"><LegacyImg image={team.lead.image} widths={[144, 288]} sizes="144px" class="hm-fill" color /></div>
          <div>
            <h3>{team.lead.name}</h3>
            <span>{team.lead.role}</span>
          </div>
          <p>{team.lead.bio}</p>
          <a href={team.lead.link.href}>{team.lead.link.label}</a>
        </article>
        <div class="hm-serviceTeam">
          <div>
            <div class="hm-eyebrow hm-eyebrowLight">{team.serviceEyebrow}</div>
            <h3>{team.serviceHeading}</h3>
          </div>
          <div class="hm-teamGrid">
            {
              serviceTeam.map((member) => (
                <article>
                  <div class="hm-teamPhoto">
                    <LegacyImg image={member} widths={[264, 400, 528, 800]} sizes="(max-width: 820px) 100vw, 264px" class="hm-fill" color />
                  </div>
                  <h4>{member.name}</h4>
                  <span>{member.role}</span>
                </article>
              ))
            }
          </div>
          <p class="hm-teamSupport">{team.serviceText}</p>
        </div>
      </div>
    </section>

    <section class="hm-contactSection" id="contact">
      <div class="hm-contactIntro">
        <div class="hm-eyebrow">{contact.eyebrow}</div>
        <h2>{contact.heading}</h2>
        <p>{contact.text}</p>
        <div>
          <strong>{contact.direct.label}</strong>
          <span>{contact.direct.name}</span>
          <span>{contact.direct.role}</span>
          <a href={`mailto:${contact.direct.email}`}>{contact.direct.email}</a>
        </div>
      </div>
      <LegacyForm form={hotelsContactForm} variant="landing" />
    </section>
  </div>
  <MicrositeFooter slot="footer" brand={brand} />
</BaseLayout>
