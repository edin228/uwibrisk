---
import ProgramNav from '../../components/site/ProgramNav.astro';
import { brand, coverageAreas, coveragePage, meta } from '../../data/legacy/hotels';
import SiteLayout from '../../layouts/SiteLayout.astro';
import '../../styles/microsites/hotels.css';

const { hero, jumpLabel, includesLabel, cta } = coveragePage;
---

<SiteLayout title={meta.coverage.title} description={meta.coverage.description} searchable section="/programs" closing={false}>
  <ProgramNav {...brand} />
  <div class="hm-site">
    <section class="hm-coverageHero">
      <div>
        <div class="hm-eyebrow">{hero.eyebrow}</div>
        <h1>{hero.heading}</h1>
      </div>
      <p>{hero.text}</p>
    </section>
    <nav class="hm-coverageJump" aria-label="Jump to coverage section">
      <strong>{jumpLabel}</strong>
      {coverageAreas.map((area) => <a href={`#${area.id}`}>{area.shortTitle}</a>)}
    </nav>
    <div class="hm-coverageRows">
      {
        coverageAreas.map((area, index) => (
          <section class:list={['hm-coverageRow', area.dark && 'hm-coverageRowDark', index % 2 && 'hm-coverageRowTint']} id={area.id}>
            <div class="hm-coverageRowTitle">
              <span>{area.number}</span>
              <h2>{area.title}</h2>
            </div>
            <p>{area.summary}</p>
            <div>
              <div class:list={['hm-eyebrow', area.dark && 'hm-eyebrowLight']}>{includesLabel}</div>
              <ul>
                {area.includes.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </section>
        ))
      }
    </div>
    <section class="hm-coverageCta">
      <div>
        <div class="hm-eyebrow">{cta.eyebrow}</div>
        <h2>{cta.heading}</h2>
      </div>
      <a href={cta.href} class="hm-button">{cta.label}</a>
    </section>
  </div>
</SiteLayout>
