---
import ProgramNav from '../../../components/site/ProgramNav.astro';
import { brand, briefArticle, briefDisclaimer, briefs, HOTEL_PATHS, type RiskBrief } from '../../../data/legacy/hotels';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import '../../../styles/microsites/hotels.css';

export function getStaticPaths() {
  return briefs.map((brief) => ({ params: { slug: brief.slug }, props: { brief } }));
}
interface Props {
  brief: RiskBrief;
}
const { brief } = Astro.props;
const a = briefArticle;
---

<SiteLayout title={`${brief.title} | UWIB Risk`} description={brief.description} type="article" searchable section="/programs" closing={false}>
  <ProgramNav {...brand} />
  <div class="hm-site">
    <article>
      <header class="hm-articleHero">
        <div class="hm-breadcrumb"><a href={HOTEL_PATHS.briefs}>{a.breadcrumbRoot}</a> / {brief.category} / {a.issuePrefix} {brief.issue}</div>
        <div class="hm-eyebrow">{brief.label}</div>
        <h1>{brief.title}</h1>
        <p>{brief.description}</p>
        <div class="hm-articleMeta"><span>{brief.date}</span><span>{brief.readTime}</span><span>{a.publication}</span></div>
      </header>

      <div class="hm-articleBody">
        <div class="hm-articleMain">
          <p class="hm-articleLead">{brief.introduction}</p>
          <p>{brief.lead}</p>
          <span class="hm-yellowRule"></span>
          {
            brief.sections.map((section, index) => (
              <div class="hm-articleSection">
                <h2>{section.title}</h2>
                {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
                {index === 0 && (
                  <div class="hm-questionBox">
                    <div class="hm-eyebrow">{a.questionsLabel}</div>
                    <ul>{brief.questions.map((question) => <li>{question}</li>)}</ul>
                  </div>
                )}
              </div>
            ))
          }
        </div>
        <aside class="hm-articleAside">
          <div class="hm-considerBox">
            <div class="hm-eyebrow">{a.considerLabel}</div>
            <p>{brief.consider}</p>
          </div>
          <div class="hm-outlineBox">
            <div class="hm-eyebrow">{a.outlineLabel}</div>
            <ul>{brief.outline.map((item) => <li>{item}</li>)}</ul>
          </div>
          <p>{briefDisclaimer}</p>
        </aside>
      </div>

      <section class="hm-checklistSection">
        <div>
          <div class="hm-eyebrow hm-eyebrowLight">{a.checklistLabel}</div>
          <h2>{brief.checklistTitle}</h2>
        </div>
        <ol>{brief.checklist.map((item, index) => <li><span>{String(index + 1).padStart(2, '0')}</span>{item}</li>)}</ol>
      </section>

      <section class="hm-articleCta">
        <div>
          <div class="hm-eyebrow">{a.ctaEyebrow}</div>
          <h2>{brief.cta}</h2>
        </div>
        <div>
          <a href={a.primaryCta.href} class="hm-button">{a.primaryCta.label}</a>
          <a href={a.secondaryCta.href} class="hm-button hm-buttonOutline">{a.secondaryCta.label}</a>
        </div>
      </section>
    </article>
  </div>
</SiteLayout>
