!/docs/migration-report.md
!/docs/alt-text-review.md
!/docs/copy-guidelines.md

# exports that may contain PII (never commit)
*submissions*.csv

# misc
.DS_Store
*.pem
.idea/
.vscode/*
!.vscode/extensions.json
